<?xml version="1.0"?>
<sdf version="1.8">
  <world name="garage_visual">
    <!-- Visual-only world. Physics consumes WorldPoseCmd from UserCommands;
         both scene models remain static, so it does not simulate locomotion. -->
    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Keep the GUI deliberately small: a useful initial shot plus the
         controls needed to inspect or follow the visual robot. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>Garage visual navigation</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <!-- Close three-quarter view of the Garage route start. -->
        <camera_pose>14 12.5 2.2 0 0.42 0.65</camera_pose>
        <camera_clip>
          <near>0.05</near>
          <far>500</far>
        </camera_clip>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>
    </gui>

    <scene>
      <ambient>0.25 0.27 0.30 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <physics name="visual_pose_updates" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>20 20 50 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 -0.25 -0.9</direction>
    </light>
    <light name="garage_fill" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>25 45 18 0 0 0</pose>
      <diffuse>0.32 0.36 0.44 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>180</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
    </light>

    <include>
      <uri>model://garage</uri>
      <name>garage</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
